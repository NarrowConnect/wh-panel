PORT=8080
ENV=development

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=wh_user
DB_PASSWORD=wh_password
DB_NAME=wh_panel_db
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production-32bytes
JWT_ACCESS_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# EasyPanel / Container App
APP_URL=http://localhost:8080
