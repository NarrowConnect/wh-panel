# ==========================================
# WH - PANEL | AMBIENTE DE PRODUÇÃO / EASYPANEL
# ==========================================

PORT=8080
ENV=production
APP_URL=https://api.seudominio.com

# ------------------------------------------
# PostgreSQL Configuration (Multi-Tenant RLS)
# ------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=wh_user
DB_PASSWORD=wh_password
DB_NAME=wh_panel_db
DB_SSLMODE=disable

# ------------------------------------------
# Redis Configuration (Cache, JWT Blacklist & Streams)
# ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# JWT Secrets & Session Expiration
# ------------------------------------------
JWT_SECRET=super-secret-jwt-key-change-in-production-32bytes
JWT_ACCESS_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ------------------------------------------
# Meta Cloud API Oficial (Aplicativo Meta da Narrow)
# ------------------------------------------
# Obtenha em: https://developers.facebook.com/apps/
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=narrow_wh_verify_secret_2026
META_API_VERSION=v20.0
META_ACCESS_TOKEN=

# ------------------------------------------
# WhatsApp API Não-Oficial (WAHA - WhatsApp HTTP API)
# Hospedado na VPS (ex: http://waha:3000 ou https://waha.seudominio.com)
# ------------------------------------------
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
